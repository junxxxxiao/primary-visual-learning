{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-scene/1.0",
  "title": "TS-04B visual scene declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "scene_version",
    "learning_goal",
    "knowledge_version",
    "teaching_contract_version",
    "layout_contract_version",
    "code_hash",
    "test_version",
    "teaching",
    "viewport_profiles"
  ],
  "properties": {
    "schema_version": { "const": "visual-scene/1.0" },
    "scene_id": { "type": "string", "minLength": 1 },
    "scene_version": { "type": "string", "minLength": 1 },
    "learning_goal": { "type": "string", "minLength": 1 },
    "knowledge_version": { "type": "string", "minLength": 1 },
    "teaching_contract_version": { "type": "string", "minLength": 1 },
    "layout_contract_version": { "const": "visual-layout/v1" },
    "code_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "test_version": { "type": "string", "minLength": 1 },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "facts"],
      "properties": {
        "status": { "enum": ["ready", "ambiguous", "timeout"] },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_id", "expected", "visual", "narration"],
            "properties": {
              "fact_id": { "type": "string", "minLength": 1 },
              "expected": { "type": "string", "minLength": 1 },
              "visual": { "type": "string", "minLength": 1 },
              "narration": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "viewport_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone", "tablet"],
      "properties": {
        "phone": { "$ref": "#/$defs/profile" },
        "tablet": { "$ref": "#/$defs/profile" }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "bounds", "font_size", "min_graphic_size", "interactive", "touch_size"],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/rect" },
        "font_size": { "type": "number", "minimum": 0 },
        "min_graphic_size": { "type": "number", "minimum": 0 },
        "interactive": { "type": "boolean" },
        "touch_size": { "type": "number", "minimum": 0 },
        "local_safe_region": { "type": ["string", "null"] }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "kind", "elements", "motion_envelopes"],
      "properties": {
        "state_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["initial", "key_process", "final", "paused", "resumed", "post_interaction", "reduced_motion", "static_fallback"]
        },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
        "motion_envelopes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element_id", "bounds"],
            "properties": {
              "element_id": { "type": "string", "minLength": 1 },
              "bounds": { "$ref": "#/$defs/rect" }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_mode", "canvas_inner_bounds", "local_safe_regions", "readability_limits", "container_metrics", "states"],
      "properties": {
        "layout_mode": { "type": "string", "minLength": 1 },
        "canvas_inner_bounds": { "$ref": "#/$defs/rect" },
        "local_safe_regions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/rect" }
        },
        "readability_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_font_size", "min_graphic_size", "min_touch_size"],
          "properties": {
            "min_font_size": { "type": "number", "minimum": 0 },
            "min_graphic_size": { "type": "number", "minimum": 0 },
            "min_touch_size": { "type": "number", "minimum": 0 }
          }
        },
        "container_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["client_width", "client_height", "scroll_width", "scroll_height", "overflow", "clip", "mask"],
          "properties": {
            "client_width": { "type": "number", "exclusiveMinimum": 0 },
            "client_height": { "type": "number", "exclusiveMinimum": 0 },
            "scroll_width": { "type": "number", "exclusiveMinimum": 0 },
            "scroll_height": { "type": "number", "exclusiveMinimum": 0 },
            "overflow": { "enum": ["visible", "auto", "hidden"] },
            "clip": { "type": "boolean" },
            "mask": { "type": "boolean" }
          }
        },
        "states": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/state" } }
      }
    }
  }
}
