# Copy to .env.local and provide a synthetic-fixture-only DeepSeek official endpoint.
TS03_API_KEY=
TS03_API_BASE_URL=https://api.deepseek.com/v1
TS03_MODEL=deepseek-v4-pro
TS03_MAX_REQUESTS=4
TS03_TIMEOUT_SECONDS=60
# Set a new unique label for every paid run; existing evidence is never overwritten.
TS03_RUN_LABEL=official-full-round-N
TS03_FIRST_SEGMENT_RUN_LABEL=official-first-segment-round-N
TS03_SEND_CONTROLLED_TEXTBOOK_CONTENT=false
