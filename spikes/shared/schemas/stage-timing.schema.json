{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-timing/1.0",
  "title": "Cross-slice stage timing trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "slice_id", "clock", "trace_started_at", "milestones", "spans"],
  "properties": {
    "schema_version": { "const": "stage-timing/1.0" },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "slice_id": { "type": "string", "pattern": "^TS-[0-9]{2}[A-Z]?$" },
    "clock": { "const": "monotonic" },
    "trace_started_at": { "type": "string", "format": "date-time" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "offset_ms", "latency_scope"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 96 },
          "offset_ms": { "type": "number", "minimum": 0 },
          "latency_scope": {
            "enum": ["user_wait_anchor", "system_output", "user_action_excluded", "diagnostic"]
          }
        }
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["span_id", "stage", "started_offset_ms", "ended_offset_ms", "duration_ms", "latency_scope", "outcome", "retry_index", "cache_status"],
        "properties": {
          "span_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "parent_span_id": { "type": ["string", "null"], "maxLength": 128 },
          "stage": { "type": "string", "minLength": 1, "maxLength": 96 },
          "started_offset_ms": { "type": "number", "minimum": 0 },
          "ended_offset_ms": { "type": "number", "minimum": 0 },
          "duration_ms": { "type": "number", "minimum": 0 },
          "latency_scope": { "enum": ["system_work", "user_action_excluded", "background_speculative"] },
          "outcome": { "enum": ["success", "failure", "timeout", "cancelled", "degraded"] },
          "retry_index": { "type": "integer", "minimum": 0 },
          "cache_status": { "enum": ["not_applicable", "miss", "hit", "write", "invalidated"] },
          "provider": { "type": ["string", "null"], "maxLength": 128 },
          "model": { "type": ["string", "null"], "maxLength": 128 },
          "input_units": { "type": ["integer", "null"], "minimum": 0 },
          "output_units": { "type": ["integer", "null"], "minimum": 0 },
          "cost_amount": { "type": ["number", "null"], "minimum": 0 },
          "cost_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "error_code": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    }
  }
}
