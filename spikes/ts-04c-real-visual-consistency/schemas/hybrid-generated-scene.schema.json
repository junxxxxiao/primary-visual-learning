{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hybrid-generated-scene/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "title", "caption", "fact_refs", "scene"],
  "properties": {
    "schema_version": {"const": "hybrid-generated-scene/0.1"},
    "sample_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 48},
    "caption": {"type": "string", "minLength": 1, "maxLength": 180},
    "fact_refs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"}},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "nodes", "connectors", "function_lines", "timeline"],
      "properties": {
        "schema_version": {"const": "hybrid-visual-scene/0.1"},
        "nodes": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "label", "x", "y", "width", "height", "style"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
              "kind": {"enum": ["point", "box", "anchor"]},
              "label": {"type": "string", "minLength": 1, "maxLength": 24},
              "x": {"type": "number", "minimum": 80, "maximum": 920},
              "y": {"type": "number", "minimum": 100, "maximum": 700},
              "width": {"type": "number", "minimum": 16, "maximum": 420},
              "height": {"type": "number", "minimum": 16, "maximum": 360},
              "style": {"type": "string", "minLength": 1, "maxLength": 32}
            }
          }
        },
        "connectors": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "from", "to", "marker_end", "style"],
            "properties": {
              "id": {"type": "string"},
              "from": {"$ref": "#/$defs/endpoint"},
              "to": {"$ref": "#/$defs/endpoint"},
              "marker_end": {"enum": ["none", "arrow"]},
              "style": {"type": "string"}
            }
          }
        },
        "function_lines": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "slope", "intercept", "domain"],
            "properties": {
              "id": {"type": "string"}, "label": {"type": "string"},
              "slope": {"type": "number", "minimum": -20, "maximum": 20},
              "intercept": {"type": "number", "minimum": -100, "maximum": 100},
              "domain": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -20, "maximum": 20}}
            }
          }
        },
        "timeline": {
          "type": "array", "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["target_id", "to", "duration_ms"],
            "properties": {
              "target_id": {"type": "string"},
              "to": {
                "type": "object", "additionalProperties": false, "minProperties": 1,
                "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
              },
              "duration_ms": {"type": "integer", "minimum": 0, "maximum": 20000}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "anchor"],
      "properties": {"node_id": {"type": "string"}, "anchor": {"enum": ["center", "top", "right", "bottom", "left"]}}
    }
  }
}
