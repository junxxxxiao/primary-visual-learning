{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-question-lesson/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "question", "answer_summary", "fact_refs", "segments"],
  "properties": {
    "schema_version": {"const": "full-question-lesson/0.1"},
    "question_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "question": {"type": "string", "minLength": 1, "maxLength": 80},
    "answer_summary": {"type": "string", "minLength": 20, "maxLength": 220},
    "fact_refs": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"}
    },
    "segments": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "title", "narration", "duration_ms", "fact_refs", "scene"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 32},
        "narration": {"type": "string", "minLength": 25, "maxLength": 180},
        "duration_ms": {"type": "integer", "minimum": 6500, "maximum": 12000},
        "fact_refs": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"}
        },
        "scene": {"$ref": "#/$defs/scene"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "timeline"],
      "properties": {
        "objects": {
          "type": "array", "minItems": 3, "maxItems": 14,
          "items": {"$ref": "#/$defs/object"}
        },
        "timeline": {
          "type": "array", "minItems": 1, "maxItems": 18,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "x", "y", "width", "height", "label", "style"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "kind": {"enum": ["tank", "ellipse", "particles", "arrow", "label", "meter"]},
        "x": {"type": "number", "minimum": 60, "maximum": 940},
        "y": {"type": "number", "minimum": 60, "maximum": 620},
        "width": {"type": "number", "minimum": 20, "maximum": 760},
        "height": {"type": "number", "minimum": 20, "maximum": 500},
        "label": {"type": "string", "maxLength": 28},
        "style": {"enum": ["water", "saltwater", "egg", "salt", "force-up", "force-down", "neutral", "highlight", "density"]}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "property", "from", "to", "start_ms", "end_ms"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "property": {"enum": ["opacity", "x", "y", "scale"]},
        "from": {"type": "number"},
        "to": {"type": "number"},
        "start_ms": {"type": "integer", "minimum": 1000, "maximum": 11000},
        "end_ms": {"type": "integer", "minimum": 1001, "maximum": 12000}
      }
    }
  }
}
